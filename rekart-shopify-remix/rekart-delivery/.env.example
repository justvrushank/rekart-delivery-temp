# Copy this file to `.env` and fill in the real values. `.env` is git-ignored.

# Public app identifier (client_id). Matches client_id in shopify.app.toml.
SHOPIFY_API_KEY=

# App client secret from the Partner Dashboard
# (Apps -> Rekart Delivery -> API credentials). SECRET — never commit the .env.
SHOPIFY_API_SECRET=

# OAuth access scopes. Keep in sync with [access_scopes] in shopify.app.toml.
SCOPES=read_orders,read_customers,write_orders

# Public URL where the app is reachable. `shopify app dev` sets this to the
# Cloudflare tunnel URL automatically; set it manually for any non-dev deploy.
SHOPIFY_APP_URL=

# Base URL (bare host, NO /api suffix) of the Rekart backend that receives data
# webhooks (orders/create, customers/create, customers/update), authenticates
# merchant logins, and serves dashboard sync stats. The app appends /api itself.
# When unset, webhook registration is skipped and install/auth still work.
# Staging: https://dev3.rekart.io   Production: https://app.rekart.io
REKART_BACKEND_URL=https://dev3.rekart.io

# URL for Rekart login endpoint (may differ from REKART_BACKEND_URL)
REKART_LOGIN_URL=https://dev3.rekart.io

# Shared static API key sent as the X-API-Key header on Remix <-> Rekart calls
# (GDPR forwarding, uninstall notifications, stats lookups, and inbound
# fulfillment-push from Rekart). Must equal REKART_STATIC_API_KEY in the backend .env.
REKART_STATIC_API_KEY=

# 32-byte hex key (64 hex chars) used to encrypt secrets at rest, e.g. the Rekart
# access token stored in ShopOnboarding. Rotating this key invalidates
# already-encrypted tokens (merchants must reconnect).
# Generate encryption key: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Connection string for the Remix app's own database (sessions, onboarding,
# fulfillment pushes, GDPR queue, product links).
# LOCAL DEV: DATABASE_URL=file:./dev.db (SQLite — default for local development)
# PRODUCTION: DATABASE_URL=postgresql://user:password@host:5432/rekart_shopify
DATABASE_URL=file:./dev.db