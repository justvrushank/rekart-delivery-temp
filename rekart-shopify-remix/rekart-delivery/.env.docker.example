# ─── Docker Compose environment ──────────────────────────────────────────────
# Copy to `.env` (git-ignored) and fill in the real secrets:
#     cp .env.docker.example .env
# Then:  docker compose up --build
#
# Compose reads this file automatically for ${VAR} interpolation. The DATABASE_URL
# and REDIS_URL are assembled inside docker-compose.yml from the values below, so
# you only set the pieces here.

# ── Shopify app credentials (Partner Dashboard → API credentials) ─────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public URL the app is served from. For local container testing this can be
# http://localhost:3000; for a real embedded app use your tunnel/production URL.
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_orders,read_customers,write_orders

# ── Secrets shared between the Remix app and the backend ──────────────────────
# 32-byte hex (64 chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Shared X-API-Key for Remix <-> Rekart calls (must match on both sides).
REKART_STATIC_API_KEY=
# Internal key the backend uses when calling Rekart's ingest/upsert endpoints.
REKART_INTERNAL_API_KEY=

# ── Rekart (Laravel) backend the Remix app talks to ───────────────────────────
# Bare host, no /api suffix. Staging: https://dev3.rekart.io  Prod: https://app.rekart.io
REKART_BACKEND_URL=https://dev3.rekart.io
REKART_LOGIN_URL=https://dev3.rekart.io

# ── Backend runtime env (development | production) ────────────────────────────
APP_ENV=development

# ── PostgreSQL (used to build both DATABASE_URLs) ─────────────────────────────
# The Remix app image uses the canonical PostgreSQL schema (prisma/schema.prisma)
# and runs `prisma migrate deploy` on boot. There is NO provider env var — Prisma
# does not allow env() in `provider`. Local non-Docker dev instead uses the sqlite
# mirror (prisma/schema.sqlite.prisma via `npm run setup:local`). See docs/DOCKER.md.
POSTGRES_USER=rekart
POSTGRES_PASSWORD=rekart
# For reference — compose assembles this from the values above and sets it on the
# app service directly: DATABASE_URL=postgresql://rekart:rekart@db:5432/rekart_shopify

# ── Host port mappings (change if these clash with local services) ────────────
APP_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6380
