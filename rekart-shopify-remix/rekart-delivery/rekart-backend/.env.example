# Shopify App credentials — get these from Partner Dashboard after registering the app
SHOPIFY_API_KEY=your_client_id_here
SHOPIFY_API_SECRET=your_client_secret_here
SHOPIFY_SCOPES=read_orders,read_customers,write_orders
SHOPIFY_APP_URL=https://your-domain.rekart.app

# Database — Rekart MySQL instance
DATABASE_URL=mysql+aiomysql://user:password@host:3306/rekart_db

# Redis — for Celery task queue (use existing Rekart Redis if available)
REDIS_URL=redis://localhost:6379/0

# Rekart backend base URL (staging).
# Production: https://app.rekart.io/api
REKART_BACKEND_URL=https://dev3.app.rekart.io/api
REKART_INTERNAL_API_KEY=your_internal_api_key_here

# Shared static API key for Remix <-> backend auth (sent as the X-API-Key header,
# Groups B & C). Must equal REKART_STATIC_API_KEY in the Remix app .env.
REKART_STATIC_API_KEY=change_me_to_a_long_random_secret

# App environment
APP_ENV=development  # development | production
